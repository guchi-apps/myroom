[Unit]
Description=MyRoom: お掃除ロボット（eufy）の稼働状態の取得（3分ごと）

[Timer]
# 稼働の開始・終了の時刻をこの間隔の精度で拾う。1回の掃除が30分ほどなので、
# 3分あれば「いつ動いたか」は十分に分かる。ローカル通信でレート制限も無い。
OnCalendar=*:0/3
# 停止中に逃した実行を起動直後に走らせる。状態が変わっていなければ行は増えない。
Persistent=true
# 毎3分ちょうどに他のタイマーと一斉に走らせない。
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
