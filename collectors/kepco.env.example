# collectors/kepco_bill_to_myroom.py 用の設定。
# **この内容を collectors/.env に追記して実値を入れる**（.env はgitignore済み・
# 収集スクリプト共通で1ファイル）。実値は 1Password の apps/MyRoom から取る。

# 検針結果のメールを受け取っている Gmail アカウント。
KEPCO_IMAP_USER=your@gmail.com

# **Gmail のアプリパスワード（16桁）。通常のログインパスワードでは通らない。**
# Google アカウント → セキュリティ → 2段階認証プロセス → アプリパスワード で発行する。
# 空白を詰めて貼ること。
KEPCO_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# 検針結果メールの差出人。電気もガスも同じアドレスから届く。
# 関西電力側で変わったときだけ書き換える。
KEPCO_MAIL_FROM=kandenweb.kensinhyo@a2.kepco.co.jp

# さかのぼって探す月数。はぴeみる電が持っている期間（25か月）に合わせている。
KEPCO_BILL_MONTHS=25

# MyRoom の受け口。ローカル検証時は http://localhost:8000/api/bills に向ける
MYROOM_BILLS_API_URL=https://myroom.gucchii.com/api/bills
