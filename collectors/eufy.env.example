# collectors/eufy_to_myroom.py 用の設定。
# **この内容を collectors/.env に追記して実値を入れる**（.env はgitignore済み・
# 収集スクリプト共通で1ファイル）。実値は 1Password の apps/MyRoom から取る。

# eufy Clean の device_id と local key。
#
# **local key はアプリからは見えない。** Tuya IoT 開発者アカウントを作り、
# eufy アプリのアカウントを紐づけてから API Explorer（または `tinytuya wizard`）で
# 取り出す。手順は collectors/README.md を参照。
EUFY_DEVICE_ID=xxxxxxxxxxxxxxxxxxxx
EUFY_LOCAL_KEY=xxxxxxxxxxxxxxxx

# LAN 上の IP。--scan で調べられる。
# **ルーターでDHCP固定にしておくこと。** 変わると読めなくなる。
EUFY_IP=192.168.2.30

# Tuya のプロトコル版。eufy はおおむね 3.3。--scan の version 欄で確認できる
EUFY_VERSION=3.3

# 状態とバッテリー残量のDP番号。**機種とファームで変わる。**
# 既定で読めない場合は --dump で実機が返す辞書を見て設定する
EUFY_STATUS_DP=15
EUFY_BATTERY_DP=104

# MyRoom の受け口。ローカル検証時は http://localhost:8000/api/cleaner に向ける
MYROOM_CLEANER_API_URL=https://myroom.gucchii.com/api/cleaner
