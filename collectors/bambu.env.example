# collectors/bambu_to_myroom.py 用の設定。
# **この内容を collectors/.env に追記して実値を入れる**（.env はgitignore済み・
# 収集スクリプト共通で1ファイル）。
#
# **1Password・GitHub secret には置かない。** 3つとも、プリンター本体の画面からいつでも
# 読み直せる値のため（アクセスコードの再取得は collectors/README.md の bambu の節）。

# プリンターの IP アドレス。ルーターで固定割り当て（DHCP予約）にしておくこと。
# 変わると繋がらなくなる（ログに「接続できません」と出る）
BAMBU_HOST=192.168.2.50

# プリンターのシリアル番号（本体のラベル、または Bambu Handy / Bambu Studio のデバイス情報。
# ログには出さない）
BAMBU_SERIAL=XXXXXXXXXXXXXXX

# LAN アクセスコード（本体の画面の WLAN の項目に表示される。再生成すると変わる。ログには出さない）。
# LAN Only Mode を有効にしなくても、クラウドへ紐付けたまま使える
BAMBU_ACCESS_CODE=00000000

# MyRoom の受け口。ローカル検証時は http://localhost:8000/api/bambu/state に向ける
MYROOM_BAMBU_API_URL=https://myroom.gucchii.com/api/bambu/state
